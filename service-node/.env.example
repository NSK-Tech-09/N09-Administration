N09_DB_HOST=database.internal
N09_DB_PORT=3306
N09_DB_USER=n09_admin_runtime
N09_DB_PASSWORD=replace-with-a-protected-secret
N09_DB_NAME=n09_admin_preprod
N09_DB_SSL=true

N09_HTTP_HOST=127.0.0.1
N09_HTTP_PORT=3000
N09_TRUSTED_REVERSE_PROXY=false

INFOMANIAK_CLIENT_ID=replace-with-the-public-client-id
INFOMANIAK_CLIENT_SECRET=replace-with-a-protected-secret
INFOMANIAK_REDIRECT_URI=https://preprod-admin.example.invalid/auth/infomaniak/callback
# Au moins 32 caractères aléatoires, distinct du secret client.
N09_SESSION_SECRET=replace-with-a-long-random-session-secret
# Diagnostic borné aux codes d'erreur prédéfinis ; laisser désactivé hors banc de validation.
N09_EXPOSE_SAFE_OIDC_ERRORS=false

# Observation inopposable des sessions centrales. La valeur par défaut reste
# disabled ; observe est refusé hors préproduction. Aucun autre mode n'existe.
N09_ADMIN_SESSION_MODE=disabled
N09_ADMIN_SESSION_IDLE_TTL_MS=1800000
N09_ADMIN_SESSION_ABSOLUTE_TTL_MS=28800000
N09_ADMIN_SESSION_TOUCH_INTERVAL_MS=300000

# Sessions de l'application pilote. Procéder successivement par issue puis
# enforce, uniquement en préproduction et après validation d'une nouvelle connexion.
N09_TASKS_SESSION_MODE=disabled
N09_TASKS_SESSION_IDLE_TTL_MS=3600000
N09_TASKS_SESSION_ABSOLUTE_TTL_MS=14400000
N09_TASKS_SESSION_TOUCH_INTERVAL_MS=300000

# Session opposable de N09 – Énergie en production. L'activation reste
# indépendante de Suivi des tâches et conserve ses propres durées.
N09_ENERGY_SESSION_MODE=disabled
N09_ENERGY_SESSION_IDLE_TTL_MS=3600000
N09_ENERGY_SESSION_ABSOLUTE_TTL_MS=14400000
N09_ENERGY_SESSION_TOUCH_INTERVAL_MS=300000

# Session applicative du portail public (production uniquement)
N09_PORTAL_SESSION_MODE=disabled
N09_PORTAL_SESSION_IDLE_TTL_MS=3600000
N09_PORTAL_SESSION_ABSOLUTE_TTL_MS=14400000
N09_PORTAL_SESSION_TOUCH_INTERVAL_MS=300000
N09_PORTAL_ORIGINS=https://nsktech.fr,https://www.nsktech.fr

# Connexion sans mot de passe. Le secret Brevo ne doit exister que dans
# l'environnement protégé du service ; aucun mot de passe utilisateur n'est stocké.
N09_EMAIL_LOGIN_ENABLED=false
N09_EMAIL_LOGIN_DELIVERY_PROVIDER=brevo
N09_EMAIL_LOGIN_SENDER_EMAIL=ne-pas-repondre@nsktech.fr
N09_EMAIL_LOGIN_SENDER_NAME=NSK Tech 09
N09_EMAIL_LOGIN_BREVO_API_KEY=replace-with-a-protected-brevo-api-key
N09_PUBLIC_ORIGIN=https://preprod-admin.nsktech.fr

# Activer uniquement pendant l'amorçage contrôlé de la préproduction.
N09_ALLOW_SYNTHETIC_PREPROD=false

# Amorçage ponctuel du premier administrateur des rattachements. Ne jamais
# conserver l'activation à true après l'opération contrôlée.
N09_ALLOW_IDENTITY_LINK_ADMIN_BOOTSTRAP=false
# Pouvoirs distincts, eux aussi activés uniquement pendant leur amorçage contrôlé.
N09_ALLOW_ACCESS_DIRECTORY_BOOTSTRAP=false
N09_ALLOW_ACCESS_DECISION_BOOTSTRAP=false
N09_ALLOW_NOTIFICATION_OPERATIONS_BOOTSTRAP=false
N09_ALLOW_OPERATOR_SESSION_BOOTSTRAP=false
N09_ALLOW_IDENTITY_STATE_BOOTSTRAP=false
N09_ALLOW_IDENTITY_REACTIVATION_BOOTSTRAP=false
N09_ALLOW_IDENTITY_DISABLEMENT_BOOTSTRAP=false
N09_ADMIN_IDENTITY_ID=00000000-0000-4000-8000-000000000000
N09_ADMIN_BOOTSTRAP_JUSTIFICATION=Décision humaine explicite à documenter

# Identité technique de N09 – Suivi des tâches. Le secret de préproduction doit
# être distinct de celui de production et comporter au moins 32 caractères.
N09_TASKS_INTERNAL_CLIENT_ID=tasks-preprod
N09_TASKS_INTERNAL_CLIENT_SECRET=replace-with-a-protected-random-secret
N09_TASKS_APPLICATION_ID=n09-suivi-taches

# Résolution signée et strictement interne des destinataires métier. Le secret
# est distinct de celui utilisé par Suivi des tâches pour publier ses événements.
N09_TASKS_NOTIFICATION_RESOLVER_ORIGIN=https://preprod-taches.example.invalid
N09_TASKS_NOTIFICATION_RESOLVER_CLIENT_ID=administration-preprod
N09_TASKS_NOTIFICATION_RESOLVER_CLIENT_SECRET=replace-with-a-distinct-protected-random-secret
N09_TASKS_NOTIFICATION_RESOLVER_TIMEOUT_MS=3000
# Le traitement autonome reste fermé par défaut. Il est autorisé en
# préproduction ou production uniquement après une décision de déploiement.
N09_ENVIRONMENT=preprod
N09_ALLOW_NOTIFICATION_PROCESSING=false
# Garde indépendante de l'envoi externe. Lors de l'ouverture, NOT_BEFORE doit
# être fixé à l'instant du Go pour bloquer tout événement historique.
N09_ALLOW_EXTERNAL_NOTIFICATION_DELIVERY=false
N09_NOTIFICATION_EXTERNAL_DELIVERY_NOT_BEFORE=2026-01-01T00:00:00.000Z
N09_TASKS_PUBLIC_ORIGIN=https://preprod-taches.nsktech.fr
N09_NOTIFICATION_PROCESSING_BATCH_SIZE=20
N09_NOTIFICATION_PROCESSING_MAX_ATTEMPTS=5
N09_NOTIFICATION_PROCESSING_LEASE_MS=60000
N09_NOTIFICATION_EMAIL_BATCH_SIZE=20
N09_NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
N09_NOTIFICATION_EMAIL_LEASE_MS=60000
N09_NOTIFICATION_EMAIL_RETRY_BASE_MS=60000

# Décision ponctuelle séparée : enregistrement du pilote et droit tasks:read.
N09_ALLOW_TASKS_PILOT_BOOTSTRAP=false
N09_TASKS_PILOT_IDENTITY_ID=00000000-0000-4000-8000-000000000000
N09_TASKS_PILOT_JUSTIFICATION=Décision humaine explicite à documenter

# Publication ponctuelle et idempotente du catalogue propre à Administration.
N09_ALLOW_ADMINISTRATION_CATALOG_BOOTSTRAP=false
